{
  "name": "shiyin-minimax-meeting-notes",
  "version": "0.5.3",
  "description": "基于 Sherpa-ONNX 本地实时转写、CAM++ 本地声纹识别与 MiniMax 的 AI 会议听记工具",
  "author": "LightningFlashEvE",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "desktop:dev": "electron desktop/main.mjs",
    "desktop:start": "electron desktop/main.mjs --production",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder",
    "desktop:dist:mac": "npm run build && electron-builder --mac --arm64 --publish never",
    "desktop:dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dev:web": "vinext dev",
    "asr:proxy": "node server/realtime-proxy.mjs",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/local-persistence.test.mjs",
    "test:native-models": "node scripts/native-model-smoke.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern release --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "drizzle-orm": "0.45.2",
    "https-proxy-agent": "7.0.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sherpa-onnx-node": "1.13.4",
    "vinext": "^0.0.50",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "concurrently": "9.2.1",
    "drizzle-kit": "0.31.10",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "next": "^16.2.12",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "^8.2.0",
    "wait-on": "9.0.3",
    "wrangler": "4.92.0"
  },
  "main": "desktop/main.mjs",
  "build": {
    "appId": "com.phenosola.shiyin",
    "productName": "拾音 AI",
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "dist/**/*"
    ],
    "files": [
      "desktop/**/*",
      "build/icon.ico",
      "build/icon.icns",
      "server/**/*",
      "dist/**/*",
      "public/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "models",
        "to": "models",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "拾音 AI 需要访问麦克风来记录会议发言。",
        "NSAudioCaptureUsageDescription": "拾音 AI 需要访问电脑声音来记录线上会议。"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "拾音 AI"
    }
  },
  "overrides": {
    "postcss": "^8.5.25"
  },
  "type": "module"
}
