MINIMAX_API_KEY=replace_with_minimax_api_key
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_TIMEOUT_MS=180000
MINIMAX_STREAM_IDLE_TIMEOUT_MS=60000
LIVE_SUMMARY_START_MS=30000
LIVE_SUMMARY_INTERVAL_MS=20000
# local（默认，不消耗云端转写额度）、dashscope 或 auto
SHIYIN_ASR_MODE=local
SHIYIN_LOCAL_ASR_MODEL_DIR=./models/asr
SHIYIN_PUNCTUATION_MODEL_PATH=./models/punctuation/model.int8.onnx
# 对话停顿约 1.2 秒后形成一句；数值越小，实时断句越快
SHIYIN_LOCAL_ASR_SILENCE_MS=1200
SHIYIN_LOCAL_ASR_THREADS=2

# 仅在 SHIYIN_ASR_MODE=dashscope 时需要
DASHSCOPE_API_KEY=

DASHSCOPE_WORKSPACE_ID=
ASR_PROXY_PORT=8788
SHIYIN_WEB_HOST=127.0.0.1
SHIYIN_WEB_PORT=3000
SHIYIN_BIND_HOST=127.0.0.1
SHIYIN_APP_ORIGIN=http://127.0.0.1:3000

NEXT_PUBLIC_ASR_PROXY_URL=ws://127.0.0.1:8788
NEXT_PUBLIC_API_URL=http://127.0.0.1:8788

SHIYIN_DATA_ROOT=./data
SHIYIN_MODEL_PATH=./models/speaker/3dspeaker_speech_campplus_sv_zh-cn_16k-common.onnx
